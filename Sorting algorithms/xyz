class Solution:
    def maxAlternatingSum(self, nums: List[int]) -> int:
        sum1 = 0
        list1 = []

        for num in nums:
            list1.append(num * num)

        list1.sort()

        for i, num in enumerate(list1):
            if i < len(list1) // 2:
                sum1 -= num
            else:
                sum1 += num

        return sum1
